# BookStore Co. - AWS (EKS) reference variables
#
# En AWS los servicios corren en Kubernetes: estas variables NO se leen de un
# archivo .env, sino de los ConfigMap y Secret de k8s/ (ver k8s/README.md).
# Este archivo solo documenta que valor lleva cada variable en AWS.
# Nunca subir un .env.aws con valores reales al repositorio.

# --- Imagenes (Amazon ECR) -------------------------------------------------
IMAGE_REGISTRY=REPLACE_WITH_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=1.0.0
# bookstore-bff, bookstore-auth, bookstore-catalog, bookstore-orders,
# bookstore-events (el frontend es una SPA en S3: no es una imagen)

# --- Comun a todos los servicios ------------------------------------------
NODE_ENV=production

# --- BFF (unico servicio HTTP, detras del ALB) -----------------------------
PORT=5001
API_BASE_PATH=/api
# Dominio de Cloudflare desde el que se sirve la SPA
CORS_ORIGINS=https://REPLACE_WITH_CLOUDFLARE_DOMAIN
# Cloudflare + ALB = 2 proxies delante de cada pod
HTTP_TRUST_PROXY_HOPS=2
HTTP_JSON_BODY_LIMIT=32kb

# --- Servicios gRPC (puertos internos del cluster) -------------------------
CATALOG_GRPC_PORT=50051
AUTH_GRPC_PORT=50052
EVENTS_GRPC_PORT=50053
ORDERS_GRPC_PORT=50054

# --- Limites de negocio ----------------------------------------------------
BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100
ORDERS_MAX_DISTINCT_ITEMS=100
ORDERS_MAX_QUANTITY_PER_ITEM=1000

# --- Access log / clickstream (BFF y Events; los lee el sidecar Vector) ----
ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=/health
ACCESS_LOG_MAX_FIELD_LENGTH=2048
ACCESS_LOG_REQUEST_ID_HEADER=X-Request-Id
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log
CLICKSTREAM_S3_BUCKET=REPLACE_WITH_CLICKSTREAM_BUCKET

# --- Autenticacion (BFF verifica tokens, Auth los emite) -------------------
# AUTH_JWT_SECRET va en un Secret de k8s, nunca en un ConfigMap
AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=bookstore_session
# La SPA se sirve por HTTPS (Cloudflare): la cookie puede ser Secure
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api

# --- Amazon RDS PostgreSQL (una instancia, un esquema por servicio) --------
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=bookstore
# Un rol por servicio; cada uno solo ve su esquema (auth, catalog, orders).
# Events no usa base de datos. Las contrasenas van en Secrets de k8s.
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=REPLACE_WITH_AUTH_DB_PASSWORD
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=REPLACE_WITH_CATALOG_DB_PASSWORD
ORDERS_DB_USER=orders_app
ORDERS_DB_PASSWORD=REPLACE_WITH_ORDERS_DB_PASSWORD
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
