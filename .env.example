# ============================================================
# Docker Compose / local reference environment
# ============================================================

COMPOSE_PROJECT_NAME=bookstore

NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:17-alpine
BOOTSTRAP_IMAGE=postgres:17

# ============================================================
# Image publishing
# ============================================================

# Registry prefix for the images (bff, auth, catalog, orders, events, frontend):
#   local                                          (local builds only)
#   docker.io/<dockerhub-user>                     (Docker Hub)
#   <account-id>.dkr.ecr.<region>.amazonaws.com    (Amazon ECR)
IMAGE_REGISTRY=local

# Image version; keep it aligned with the VERSION file
IMAGE_TAG=8.1.0

# ============================================================
# Published host ports
# ============================================================

# Only the frontend, the BFF and PostgreSQL are published to the host.
FRONTEND_HOST_PORT=8080
BFF_HOST_PORT=5001
POSTGRES_HOST_PORT=5432

# ============================================================
# Frontend container / reverse proxy
# ============================================================

NGINX_PORT=80
API_PROXY_PREFIX=/api
PROXY_PASS=http://bff:5001

# ============================================================
# Vite build-time configuration
# ============================================================

VITE_API_BASE_URL=/
VITE_CURRENCY_LOCALE=es-CO
VITE_CURRENCY_CODE=COP

# ============================================================
# Common runtime
# ============================================================

NODE_ENV=development

# ============================================================
# BFF (HTTP entry point for the SPA)
# ============================================================

PORT=5001
API_BASE_PATH=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# gRPC services (internal ports)
# ============================================================
# The BFF (and Orders, for Catalog) reach each service at <service-name>:<port>.

CATALOG_GRPC_PORT=50051
AUTH_GRPC_PORT=50052
EVENTS_GRPC_PORT=50053
ORDERS_GRPC_PORT=50054

# ============================================================
# Business limits
# ============================================================

# Catalog
BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100

# Orders
ORDERS_MAX_DISTINCT_ITEMS=100
ORDERS_MAX_QUANTITY_PER_ITEM=1000

# ============================================================
# HTTP proxy awareness and enriched access/clickstream logging
# (BFF access log and Events clickstream; read by Vector)
# ============================================================

HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true
ACCESS_LOG_EXCLUDE_PATHS=/health
ACCESS_LOG_MAX_FIELD_LENGTH=2048
ACCESS_LOG_REQUEST_ID_HEADER=X-Request-Id
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log

# ============================================================
# Authentication / instructional session identity
# (shared by the BFF, which verifies tokens, and Auth)
# ============================================================

AUTH_JWT_SECRET=replace_this_local_secret_with_at_least_32_random_characters
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=bookstore_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api

# ============================================================
# PostgreSQL connection
# ============================================================
# Every service uses the same instance and database; each one
# connects with its own role and its own schema (auth, catalog,
# orders). Events does not use the database.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookstore

# ============================================================
# Administrative identity (local PostgreSQL and bootstrap only)
# ============================================================

DB_ADMIN_USER=bookstore_admin
DB_ADMIN_PASSWORD=change_me_for_local_development

# ============================================================
# Microservice runtime database identities (one role per schema)
# ============================================================

AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=change_me_for_local_development

CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=change_me_for_local_development

ORDERS_DB_USER=orders_app
ORDERS_DB_PASSWORD=change_me_for_local_development

# ============================================================
# Data ingestion identity
# ============================================================

INGEST_DB_USER=bookstore_ingest
INGEST_DB_PASSWORD=change_me_for_local_development

# ============================================================
# Database client settings
# ============================================================

DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
