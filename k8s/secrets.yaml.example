# (Este archivo termina en .example a proposito: asi "kubectl apply -f k8s/"
# no lo aplica por accidente con valores de ejemplo.)
#
# EJEMPLO de los Secrets que necesitan los servicios. NO lo apliques tal cual:
# los valores de aqui son marcadores y los Secrets reales no se suben al repo.
# Crealos con kubectl (ver k8s/README.md, paso 5):
#
#   kubectl -n bookstore create secret generic db-catalog \
#     --from-literal=DB_USER=catalog_app --from-literal=DB_PASSWORD='...'
#
# Un Secret por servicio con base de datos: cada pod recibe solo la
# contrasena de SU rol (catalog_app solo puede ver el esquema catalog).
# Events no usa base de datos y no necesita ninguno.
apiVersion: v1
kind: Secret
metadata:
  name: db-auth
  namespace: bookstore
type: Opaque
stringData:
  DB_USER: auth_app
  DB_PASSWORD: REPLACE_WITH_AUTH_DB_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: db-catalog
  namespace: bookstore
type: Opaque
stringData:
  DB_USER: catalog_app
  DB_PASSWORD: REPLACE_WITH_CATALOG_DB_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: db-orders
  namespace: bookstore
type: Opaque
stringData:
  DB_USER: orders_app
  DB_PASSWORD: REPLACE_WITH_ORDERS_DB_PASSWORD
---
# Secreto con el que se firman los JWT. Lo usan Auth (para emitirlos) y el
# BFF (para verificarlos). Minimo 32 caracteres.
apiVersion: v1
kind: Secret
metadata:
  name: jwt
  namespace: bookstore
type: Opaque
stringData:
  AUTH_JWT_SECRET: REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
